<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutEmptyStateRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivEmptyIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Empty state icon"
        android:src="@drawable/ic_tasks"
        app:tint="@color/text_muted" />

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="No records found"
        android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvEmptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Items will appear here once created."
        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
        android:textColor="@color/text_secondary" />

</LinearLayout>
