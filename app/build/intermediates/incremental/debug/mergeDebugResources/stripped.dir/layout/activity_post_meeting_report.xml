<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingVertical="@dimen/space_4">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_rounded"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_toEndOf="@id/btnBack"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Post-Meeting Form"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleLarge"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly Progress &amp; Feedback Report"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Linked Meeting Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="@color/surface_subtle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reporting for Core Meeting:"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvMeetingContextTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="" tools:text="Weekly Chapter Sync &amp; Hackathon Prep"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMeetingContextSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friday, Oct 24 • Seminar Hall B, TKIET"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                        android:textColor="@color/text_muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Input 1: Progress -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilProgress"
                style="@style/Widget.GDGCoreHQ.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:hint="Weekly Progress &amp; Deliverables *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input 2: Roadblocks -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRoadblocks"
                style="@style/Widget.GDGCoreHQ.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                android:hint="Current Roadblocks / Assistance Needed *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRoadblocks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Input 3: Feedback -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFeedback"
                style="@style/Widget.GDGCoreHQ.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_6"
                android:hint="Meeting Feedback &amp; Suggestions (Optional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFeedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="2"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Primary Submit CTA -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitReport"
                style="@style/Widget.GDGCoreHQ.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Submit Post-Meeting Report" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
