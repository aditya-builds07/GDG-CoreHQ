<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GDGCoreHQ.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Status Tag -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2">

            <TextView
                android:id="@+id/tvMeetingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_chip_rounded"
                android:backgroundTint="@color/color_info_container"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:text="Upcoming Sync"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/status_info" />

            <TextView
                android:id="@+id/tvPublishedBy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Published by Organizer"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/text_muted" />
        </RelativeLayout>

        <!-- Meeting Title -->
        <TextView
            android:id="@+id/tvMeetingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekly Chapter Sync &amp; Hackathon Prep"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
            android:textColor="@color/text_primary" />

        <!-- Date & Time -->
        <TextView
            android:id="@+id/tvMeetingDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="@dimen/space_1"
            app:drawableTint="@color/text_secondary"
            android:gravity="center_vertical"
            android:text="Friday, Oct 24, 2026 • 05:00 PM - 06:30 PM"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
            android:textColor="@color/text_secondary" />

        <!-- Location -->
        <TextView
            android:id="@+id/tvMeetingLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:drawableStart="@drawable/ic_location"
            android:drawablePadding="@dimen/space_1"
            app:drawableTint="@color/text_secondary"
            android:gravity="center_vertical"
            android:text="Seminar Hall B, TKIET"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_2"
            android:background="@color/border" />

        <!-- Topics Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_1"
            android:text="Agenda Topics:"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
            android:textColor="@color/text_primary" />

        <!-- Topics Text -->
        <TextView
            android:id="@+id/tvMeetingTopics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="• Review registration milestone\n• Sponsorship deck updates\n• Roadblock check-in"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
            android:textColor="@color/text_secondary" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
