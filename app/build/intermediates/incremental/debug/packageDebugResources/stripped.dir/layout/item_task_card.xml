<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GDGCoreHQ.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: Dept Chip + Overdue Warning -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2">

            <TextView
                android:id="@+id/tvTaskDept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="@drawable/bg_chip_rounded"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:text="Design"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvOverdueBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_chip_rounded"
                android:backgroundTint="@color/color_error_container"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:text="⚠ Overdue > 48h (Strike Risk)"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/status_error"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- Task Title -->
        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Task Title"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
            android:textColor="@color/text_primary" />

        <!-- Task Description -->
        <TextView
            android:id="@+id/tvTaskDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="Task description details go here..."
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
            android:textColor="@color/text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/space_2"
            android:background="@color/border" />

        <!-- Footer: Assignee + Deadline -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTaskAssignee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:drawableStart="@drawable/ic_profile"
                android:drawablePadding="@dimen/space_1"
                app:drawableTint="@color/text_secondary"
                android:gravity="center_vertical"
                android:text="Assigned: Siddhi Kulkarni"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvTaskDeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Due: Oct 24, 2026"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/text_muted" />
        </RelativeLayout>

        <!-- Status Change Row -->
        <LinearLayout
            android:id="@+id/layoutStatusButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveProgress"
                style="@style/Widget.GDGCoreHQ.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:minHeight="36dp"
                android:text="→ In Progress"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoveDone"
                style="@style/Widget.GDGCoreHQ.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="Mark Done"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
