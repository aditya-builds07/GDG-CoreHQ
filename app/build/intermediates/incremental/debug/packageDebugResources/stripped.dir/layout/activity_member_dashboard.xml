<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingTop="@dimen/space_4">

            <!-- Member Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvMemberGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hi, Siddhi"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Headline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMemberRolePrn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Design &amp; Web Lead • PRN2024001"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_rounded"
                    android:contentDescription="Profile"
                    android:padding="10dp"
                    android:src="@drawable/ic_profile" />
            </RelativeLayout>

            <!-- Strike Indicator Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStrikeStatus"
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStrikeIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/space_3"
                        android:background="@drawable/bg_chip_rounded"
                        android:backgroundTint="@color/color_success_container"
                        android:contentDescription="Strike status"
                        android:padding="8dp"
                        android:src="@drawable/ic_strike"
                        app:tint="@color/status_success" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStrikeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accountability Status: Good"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvStrikeSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Strikes • Attendance &amp; tasks on schedule"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Digital Attendance QR Card (PRD §3.2) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAttendanceQr"
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_2">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="My Attendance QR"
                                android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvQrStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Encrypted • Present to Chapter Admin"
                                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/btnRefreshQr"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_chip_rounded"
                            android:contentDescription="Refresh QR Code"
                            android:padding="8dp"
                            android:src="@drawable/ic_qr_scan"
                            app:tint="@color/brand_navy" />
                    </RelativeLayout>

                    <!-- QR Display Frame -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/space_2"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp">

                        <ImageView
                            android:id="@+id/ivAttendanceQr"
                            android:layout_width="200dp"
                            android:layout_height="200dp"
                            android:contentDescription="Encrypted Attendance QR Code"
                            android:padding="12dp" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvQrPrnLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="PRN: PRN2024001"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                        android:textColor="@color/brand_navy" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Upcoming Meeting Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="@color/brand_lavender">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next Chapter Meeting"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvMeetingTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="Weekly Chapter Sync &amp; Hackathon Prep"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMeetingSchedule"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="@dimen/space_1"
                        app:drawableTint="@color/text_secondary"
                        android:gravity="center_vertical"
                        android:text="Friday, Oct 24 • 05:00 PM • Seminar Hall B"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnViewAgenda"
                            style="@style/Widget.GDGCoreHQ.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="View Agenda"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPostMeetingReport"
                            style="@style/Widget.GDGCoreHQ.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="Post-Meeting Form"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- My Assigned Tasks Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyTasks"
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="@color/brand_mint">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:text="My Assigned Tasks"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:text="Open Kanban →"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                            android:textColor="@color/text_primary" />
                    </RelativeLayout>

                    <TextView
                        android:id="@+id/tvMyTaskSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_2"
                        android:text="1 Task In Progress • 0 Overdue"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reimbursements Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4"
                app:cardBackgroundColor="@color/brand_peach">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Expense Reimbursements"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="Submit physical receipt photos for chapter event purchases"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnNewExpense"
                            style="@style/Widget.GDGCoreHQ.Button.Primary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_2"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="+ New Expense"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExpenseHistory"
                            style="@style/Widget.GDGCoreHQ.Button.Secondary"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:minHeight="40dp"
                            android:text="View History"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Pill Navigation Bar for Member -->
    <LinearLayout
        android:id="@+id/bottomNavPill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:background="@drawable/bg_floating_nav"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_selected"
            android:contentDescription="Home"
            android:padding="10dp"
            android:src="@drawable/ic_dashboard"
            app:tint="@color/surface" />

        <ImageView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="My Tasks"
            android:padding="10dp"
            android:src="@drawable/ic_tasks"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navAgenda"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Agendas"
            android:padding="10dp"
            android:src="@drawable/ic_agenda"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navExpenses"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Expenses"
            android:padding="10dp"
            android:src="@drawable/ic_receipt"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Profile"
            android:padding="10dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/text_secondary" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
