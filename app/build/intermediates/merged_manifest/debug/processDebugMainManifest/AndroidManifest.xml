<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gdgcorehq.app"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="34" />

    <!-- Network access for future Firebase backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.gdgcorehq.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.gdgcorehq.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GDGCoreHQ"
        android:usesCleartextTraffic="false" >

        <!-- Launcher Activity: Login Screen per PRD §3.1 -->
        <activity
            android:name="com.gdgcorehq.app.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.GDGCoreHQ" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foundation Verification Activity -->
        <activity
            android:name="com.gdgcorehq.app.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Super Admin Activities -->
        <activity
            android:name="com.gdgcorehq.app.AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.QrScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.AdminTasksActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.AgendaManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.ReimbursementReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.StrikeDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Core Member Activities -->
        <activity
            android:name="com.gdgcorehq.app.MemberDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.MemberTasksActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.MemberAgendaActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.PostMeetingReportActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.NewExpenseActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />
        <activity
            android:name="com.gdgcorehq.app.ExpenseHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Shared Activities -->
        <activity
            android:name="com.gdgcorehq.app.ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.gdgcorehq.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>