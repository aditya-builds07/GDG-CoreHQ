<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding"
        android:paddingTop="@dimen/space_4">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_rounded"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/space_3"
                android:layout_toEndOf="@id/btnBack"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Global Task Board"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleLarge"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chapter Task Delegation &amp; Kanban"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- Add Task Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddTask"
                style="@style/Widget.GDGCoreHQ.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:minHeight="40dp"
                android:text="+ Task"
                android:textSize="12sp" />
        </RelativeLayout>

        <!-- Department Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_3"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutDepartmentFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/bg_nav_selected"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_1"
                    android:text="All Depts"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                    android:textColor="@color/surface" />

                <TextView
                    android:id="@+id/filterDesign"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/bg_chip_rounded"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_1"
                    android:text="Design"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/filterTech"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/bg_chip_rounded"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_1"
                    android:text="Technical"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/filterPR"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_2"
                    android:background="@drawable/bg_chip_rounded"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_1"
                    android:text="PR &amp; Outreach"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/filterLogistics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_rounded"
                    android:paddingHorizontal="@dimen/space_3"
                    android:paddingVertical="@dimen/space_1"
                    android:text="Logistics"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Status Column Tabs: To-Do, In Progress, Done -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabStatus"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/space_3"
            android:background="@drawable/bg_chip_rounded"
            app:tabIndicatorColor="@color/brand_navy"
            app:tabIndicatorFullWidth="false"
            app:tabSelectedTextColor="@color/brand_navy"
            app:tabTextColor="@color/text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To-Do" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Progress" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Done" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Tasks Scroll Container -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/layoutTasksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="96dp" />
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Floating Pill Navigation Bar (Admin) -->
    <LinearLayout
        android:id="@+id/bottomNavPill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:background="@drawable/bg_floating_nav"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Dashboard"
            android:padding="10dp"
            android:src="@drawable/ic_dashboard"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_selected"
            android:contentDescription="Tasks"
            android:padding="10dp"
            android:src="@drawable/ic_tasks"
            app:tint="@color/surface" />

        <ImageView
            android:id="@+id/navScanner"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="QR Scanner"
            android:padding="10dp"
            android:src="@drawable/ic_qr_scan"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navExpenses"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Reimbursements"
            android:padding="10dp"
            android:src="@drawable/ic_receipt"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navStrikes"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Strikes"
            android:padding="10dp"
            android:src="@drawable/ic_strike"
            app:tint="@color/text_secondary" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
