<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.GDGCoreHQ.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Row: Member + Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2">

            <TextView
                android:id="@+id/tvMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Ananya Shinde"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_rounded"
                android:backgroundTint="@color/color_warning_container"
                android:paddingHorizontal="@dimen/space_2"
                android:paddingVertical="@dimen/space_1"
                android:text="Pending Review"
                android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                android:textColor="@color/status_warning" />
        </RelativeLayout>

        <!-- Category & Date -->
        <TextView
            android:id="@+id/tvCategoryDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Printing &amp; Swag • Oct 19, 2026"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
            android:textColor="@color/text_secondary" />

        <!-- Amount -->
        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/space_2"
            android:text="₹1,250.00"
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleLarge"
            android:textColor="@color/text_primary" />

        <!-- Simulated Receipt Thumbnail Container -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.GDGCoreHQ.Card"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginBottom="@dimen/space_2"
            app:cardBackgroundColor="@color/surface_subtle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Receipt Preview"
                    android:src="@drawable/ic_receipt"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvReceiptFilename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_1"
                    android:text="receipt_banners_tkiet.jpg"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rejection Reason if Rejected -->
        <TextView
            android:id="@+id/tvRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_2"
            android:background="@drawable/bg_chip_rounded"
            android:backgroundTint="@color/color_error_container"
            android:padding="@dimen/space_2"
            android:text="Rejection Reason: Missing vendor tax invoice."
            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
            android:textColor="@color/status_error"
            android:visibility="gone" />

        <!-- Action Buttons (Visible for Pending) -->
        <LinearLayout
            android:id="@+id/layoutReviewActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                style="@style/Widget.GDGCoreHQ.Button.Destructive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_2"
                android:minHeight="40dp"
                android:text="✕ Reject"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprove"
                style="@style/Widget.GDGCoreHQ.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/status_success"
                android:minHeight="40dp"
                android:text="Approve (Reimburse)"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
