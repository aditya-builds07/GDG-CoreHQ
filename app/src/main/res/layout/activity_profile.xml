<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/page_padding"
            android:paddingVertical="@dimen/space_4">

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_chip_rounded"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/space_3"
                    android:layout_toEndOf="@id/btnBack"
                    android:text="Member Profile"
                    android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleLarge"
                    android:textColor="@color/text_primary" />
            </RelativeLayout>

            <!-- Profile Info Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/bg_chip_rounded"
                        android:backgroundTint="@color/brand_lavender"
                        android:contentDescription="Avatar"
                        android:padding="16dp"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/brand_navy" />

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_3"
                        android:text="" tools:text="Member Name"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Headline"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvProfileDept"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="" tools:text="Department � Role"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvProfilePrn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:background="@drawable/bg_chip_rounded"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="@dimen/space_1"
                        android:text="" tools:text="PRN: PRN2024001"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                        android:textColor="@color/brand_navy" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/space_4"
                        android:background="@color/border" />

                    <!-- Organization Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chapter:"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_2"
                            android:text="Google Developer Groups on Campus • TKIET"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Email:"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Label"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvProfileEmail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" tools:text="member@gdg.org"
                            android:textAppearance="@style/TextAppearance.GDGCoreHQ.Body"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Strike Status Card (PRD §3.1 and §3.6) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStrikeInfo"
                style="@style/Widget.GDGCoreHQ.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_6"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accountability &amp; Strikes"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.TitleMedium"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvProfileStrikes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="Current Strikes: 1 / 3"
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.BodyLarge"
                        android:textColor="@color/status_warning" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_1"
                        android:text="Strikes are automatically logged when absent from meeting check-in or when a task is overdue by 48 hours."
                        android:textAppearance="@style/TextAppearance.GDGCoreHQ.Caption"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sign Out Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOut"
                style="@style/Widget.GDGCoreHQ.Button.Destructive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sign Out" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Pill Navigation Bar (Member) -->
    <LinearLayout
        android:id="@+id/bottomNavPill"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="@dimen/space_4"
        android:layout_marginBottom="@dimen/space_4"
        android:background="@drawable/bg_floating_nav"
        android:elevation="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_2">

        <ImageView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Home"
            android:padding="10dp"
            android:src="@drawable/ic_dashboard"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navTasks"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="My Tasks"
            android:padding="10dp"
            android:src="@drawable/ic_tasks"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navAgenda"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Agendas"
            android:padding="10dp"
            android:src="@drawable/ic_agenda"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navExpenses"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:contentDescription="Expenses"
            android:padding="10dp"
            android:src="@drawable/ic_receipt"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_selected"
            android:contentDescription="Profile"
            android:padding="10dp"
            android:src="@drawable/ic_profile"
            app:tint="@color/surface" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
