<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for future Firebase backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GDGCoreHQ"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Launcher Activity: Login Screen per PRD §3.1 -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.GDGCoreHQ">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foundation Verification Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Super Admin Activities -->
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".AdminTasksActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".AgendaManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".ReimbursementReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".StrikeDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Core Member Activities -->
        <activity
            android:name=".MemberDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".MemberTasksActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".MemberAgendaActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".PostMeetingReportActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".NewExpenseActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".ExpenseHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Shared Activities -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

    </application>

</manifest>
