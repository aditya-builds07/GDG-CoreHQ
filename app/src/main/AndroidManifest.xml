<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for future Firebase backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera access for ML Kit QR attendance scanner -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Push notification permission for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GDGCoreHQ"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <!-- Launcher Activity: Video Splash Screen per Rule R08 & R09 -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.GDGCoreHQ.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Standard Child Activity: Login Screen per PRD §3.1 -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />


        <!-- Super Admin Activities -->
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".QrScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".AdminTasksActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".AgendaManagementActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".ReimbursementReviewActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".StrikeDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Core Member Activities -->
        <activity
            android:name=".MemberDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".MemberTasksActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".MemberAgendaActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".PostMeetingReportActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".NewExpenseActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <activity
            android:name=".ExpenseHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- Shared Activities -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.GDGCoreHQ" />

        <!-- FileProvider for camera receipt capture per PRD §3.5 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging Service for Agendas and Strike Warnings -->
        <service
            android:name=".service.CoreHQMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
