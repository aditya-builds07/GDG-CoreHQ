rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Receipts folder: /receipts/{userId}/{fileName}
    match /receipts/{userId}/{fileName} {
      // Allow read: Only Super Admins and the original uploading member
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN'
      );

      // Allow write: Only authenticated members uploading to their own path,
      // restricted to image content types (< 5MB)
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
